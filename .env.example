# Copy this file to .env and paste your key. .env is git-ignored and only read by the server.
ANTHROPIC_API_KEY=

# Optional
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort for answers: low | medium | high | xhigh | max
ASK_EFFORT=low
ASK_READ_MODEL=claude-haiku-5-5
# Number of slide pages retrieved per question
ASK_TOP_K=8
PORT=8787
